<?xml version="1.0" encoding="UTF-8"?>

<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>KivuStay</display-name>

    <!-- Database connection configuration -->

   <context-param>
    <param-name>db.url</param-name>
    <param-value>jdbc:mysql://localhost:3306/kivustay?useSSL=false&amp;allowPublicKeyRetrieval=true&amp;serverTimezone=UTC</param-value>
</context-param>
    <context-param>
        <param-name>db.username</param-name>
        <param-value>root</param-value>
    </context-param>

    <context-param>
        <param-name>db.password</param-name>
        <param-value>dieum321</param-value>
    </context-param>
    <!-- Booking configuration -->

    <context-param>
        <param-name>booking.maxStayDays</param-name>
        <param-value>30</param-value>
    </context-param>

    <context-param>
        <param-name>booking.taxRate</param-name>
        <param-value>0.10</param-value>
    </context-param>
    <!-- Default application homepage -->
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

</web-app>